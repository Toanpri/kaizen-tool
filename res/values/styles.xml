<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="characterSelectedBackground">@color/selectedBackground</item>
        <item name="characterPathBarBackground">@color/pathBarBackground</item>
        <item name="characterDivider">@color/divider</item>
    </style>

    <!-- Theme Rem (xanh dương nhạt): màu chủ đạo + nền panel/divider đổi theo
         nhân vật; bản tối của các màu Rem nằm ở values-night (giữ nguyên cơ chế). -->
    <style name="AppTheme_Rem" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">#79AEE8</item>
        <item name="android:colorPrimaryDark">#5B93D6</item>
        <item name="android:colorAccent">#A9CDF0</item>
        <item name="android:windowBackground">@color/windowBackground</item>
        <item name="android:popupMenuStyle">@style/PopupMenuStyle</item>
        <item name="characterSelectedBackground">@color/selectedBackgroundRem</item>
        <item name="characterPathBarBackground">@color/pathBarBackgroundRem</item>
        <item name="characterDivider">@color/dividerRem</item>
    </style>

    <style name="PopupMenuStyle" parent="android:Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">?attr/characterSelectedBackground</item>
    </style>

    <style name="DialogTheme" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/windowBackground</item>
    </style>

    <style name="DialogTheme_Rem" parent="android:Theme.Material.Light.Dialog">
        <item name="android:colorPrimary">#79AEE8</item>
        <item name="android:colorPrimaryDark">#5B93D6</item>
        <item name="android:colorAccent">#A9CDF0</item>
        <item name="android:windowBackground">@color/windowBackground</item>
    </style>

    <!-- Dialog tiến trình: giữ ảnh Rem khóc làm nền -->

    <!-- Dialog tiến trình kiểu ZArchiver: window trong suốt, nền tối bo góc
         vẽ bằng drawable bên trong layout (không còn khối trắng thừa) -->
    <style name="ProgressDialogTheme" parent="android:Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <!-- Bottom sheet trượt từ dưới lên, kiểu ZArchiver -->
    <style name="BottomSheetDialogTheme" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="BottomSheetDialogTheme_Rem" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorPrimary">#79AEE8</item>
        <item name="android:colorPrimaryDark">#5B93D6</item>
        <item name="android:colorAccent">#A9CDF0</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/BottomSheetAnimation</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="BottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>
</resources>
