<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@color/colorPrimary"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- Normal bar -->
    <LinearLayout
        android:id="@+id/toolbar_normal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_nav"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_hamburger"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:singleLine="true"
            android:text="Kaizen Tool"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btn_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Tìm kiếm"
            android:src="@drawable/ic_search"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_sort"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sắp xếp"
            android:src="@drawable/ic_sort"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_view"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chế độ xem"
            android:src="@drawable/ic_list"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_overflow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thêm"
            android:src="@drawable/ic_more"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Selection bar -->
    <LinearLayout
        android:id="@+id/toolbar_selection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimaryDark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/sel_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/sel_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 đã chọn"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/sel_copy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sao chép"
            android:src="@drawable/ic_copy"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/sel_cut"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cắt"
            android:src="@drawable/ic_cut"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/sel_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa"
            android:src="@drawable/ic_delete"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/sel_compress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Nén"
            android:src="@drawable/ic_compress"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/sel_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chia sẻ"
            android:src="@drawable/ic_share"
            android:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/sel_all"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Chọn tất cả"
            android:src="@drawable/ic_select_all"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Search bar -->
    <LinearLayout
        android:id="@+id/toolbar_search"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/search_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đóng tìm kiếm"
            android:src="@drawable/ic_back"
            android:tint="#FFFFFF" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Tìm kiếm"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#B3FFFFFF"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Xóa"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
