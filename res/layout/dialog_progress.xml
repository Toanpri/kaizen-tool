<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog tiến trình Y HỆT ZArchiver: Rem ngồi trên mép, không bị cắt -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false">

    <!-- Cột chính: spacer trong suốt + nội dung dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Spacer trong suốt 64dp: Rem ngồi cao, chân đung đưa qua mép -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="64dp" />

        <!-- Khung chính: ảnh nền Rem (centerCrop, không méo) + nội dung phủ lên -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Ảnh nền: centerCrop để lấp đầy mà không bị kéo giãn -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/popup_bg_rounded"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="10dp">

            <!-- Tiêu đề -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đang nén:"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <!-- Hàng: đường dẫn file (trái) + % (phải) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#9E9E9E"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tvPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="0%"
                    android:textColor="#AB47BC"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Thanh progress RGB animate liên tục -->
            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:max="100"
                android:progress="0" />

            <!-- Checkbox giữ màn hình bật -->
            <CheckBox
                android:id="@+id/cbKeepScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Giữ cho màn hình bật"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#AB47BC" />

            <!-- 2 nút chữ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HUỶ"
                    android:textColor="#CE93D8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />

                <Button
                    android:id="@+id/btnHide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ẨN"
                    android:textColor="#CE93D8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Bé Rem: 56x112dp, hông (56dp) = đúng mép dialog -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="112dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="24dp"
        android:src="@drawable/rem_dialog"
        android:scaleType="fitCenter"
        android:contentDescription="Rem" />

</FrameLayout>
