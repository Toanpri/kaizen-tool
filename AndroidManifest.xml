<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kaizen.tool"
    android:versionCode="26"
    android:versionName="1.2-m7">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Android 13+: notification tien trinh can quyen runtime (tu targetSdk 33) — app xin luc khoi dong, xem onCreate -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- BẮT BUỘC cho Shizuku: server chỉ gửi binder cho app khai báo quyền này -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:label="kz tool"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <!-- BẮT BUỘC để hiện trong danh sách Shizuku -->
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M5: Settings + About -->
        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".AboutActivity" android:exported="false" />

        <!-- In-app media viewer -->
        <activity android:name=".ImageViewerActivity" android:exported="false" />
        <activity android:name=".VideoPlayerActivity" android:exported="false" />
        <activity android:name=".AudioPlayerActivity" android:exported="false" />

        <provider
            android:name=".ApkFileProvider"
            android:authorities="com.kaizen.tool.apkprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".GenericFileProvider"
            android:authorities="com.kaizen.tool.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- v1.1-m1: Shizuku binder receiver (custom, không dùng lib chính thức) -->
        <provider
            android:name="com.kaizen.tool.ShizukuProvider"
            android:authorities="com.kaizen.tool.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Cài gói split (.apks/.xapk/.apkm): nhận kết quả PackageInstaller session -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kaizen.tool.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
